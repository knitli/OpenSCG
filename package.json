{
  "name": "@knitli/openscg",
  "version": "0.1.0-draft.0",
  "description": "OpenSCG: an open JSON Schema, semantic specification, and conformance suite for structured security classification guides (SCGs). Not an official government standard.",
  "license": "Apache-2.0",
  "author": "Knitli Inc. <hello@knit.li>",
  "homepage": "https://github.com/knitli/OpenSCG#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knitli/OpenSCG.git"
  },
  "bugs": {
    "url": "https://github.com/knitli/OpenSCG/issues"
  },
  "keywords": [
    "security-classification-guide",
    "scg",
    "json-schema",
    "classification",
    "isoo",
    "openscg"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "spec",
    "conformance",
    "examples",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run embed-schema && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run check && npm run typecheck && npm run test && npm run build",
    "prepack": "npm run clean && npm run build",
    "embed-schema": "node scripts/embed-schema.mjs && biome format --write src/generated",
    "vectors:attestation": "tsx scripts/generate-attestation-vectors.ts",
    "vectors:payload": "tsx scripts/generate-payload-vectors.ts",
    "conformance:generate": "tsx scripts/generate-conformance-cases.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "asn1js": "^4.0.0",
    "pkijs": "^4.0.1"
  }
}
